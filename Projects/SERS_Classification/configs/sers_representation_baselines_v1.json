{
  "protocol_version": "sers-representation-baselines-v1",
  "status_before_model_execution": "predeclared",
  "created_date": "2026-07-23",
  "protocol_amendments_before_model_screening": [
    {
      "stage": "strict determinism smoke test before any AE/DAE candidate metric",
      "change": "Specify nearest-neighbour decoder upsampling followed by learned convolution instead of CUDA linear interpolation.",
      "reason": "PyTorch reported that upsample_linear1d_backward_out_cuda has no deterministic implementation. No candidate training result, validation metric, target probe, domain probe, outer result, stress result, or poster result had been calculated. Nearest upsampling preserves the predeclared interpolation-plus-convolution decoder structure while satisfying the mandatory exact-rerun requirement."
    }
  ],
  "terminal_scope": {
