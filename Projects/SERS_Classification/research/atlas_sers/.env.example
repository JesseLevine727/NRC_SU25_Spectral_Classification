# Keep this path outside the Git checkout.
ATLAS_PRIVATE_ROOT=/absolute/path/to/private/atlas_inputs

# Immutable native vendor exports used only for source-reversibility checks.
ATLAS_NATIVE_ROOT=/absolute/path/to/private/atlas_native_sources

# Generated row-level outputs and fitted models remain local.
ATLAS_ARTIFACT_ROOT=/absolute/path/to/private/atlas_artifacts
