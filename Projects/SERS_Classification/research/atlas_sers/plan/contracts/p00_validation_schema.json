{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-sers-p00-validation-report-v1",
  "title": "ATLAS P00 validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "phase",
    "status",
    "run_id",
    "protected_state_sha256",
    "checks",
    "diagnostics",
    "fit_invocations",
    "required_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "p00-validation-report-v1"},
    "protocol_version": {"const": "atlas-sers-research-master-plan-v1"},
    "phase": {"const": "P00"},
    "status": {"enum": ["pass", "blocked", "fail"]},
    "run_id": {"type": "string", "pattern": "^P00-[0-9a-f]{24}$"},
    "protected_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "diagnostics": {"type": "object"},
    "fit_invocations": {"const": 0},
    "required_artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
