{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-sers-row-prediction-schema-v1",
  "title": "ATLAS SERS row-level prediction record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_version", "code_sha256", "config_sha256", "input_sha256",
    "experiment_id", "run_id", "scope", "task_id", "information_regime",
    "population_id", "representation_id", "model_id", "hyperparameter_sha256",
    "station", "outer_repeat", "outer_fold", "seed", "split_role",
    "observation_uid", "master_sample_id", "instrument", "sensor_family",
    "target_analyte", "true_label", "predicted_label", "class_vocabulary",
    "probabilities", "run_status"
  ],
  "properties": {
    "protocol_version": {"type": "string", "const": "atlas-sers-research-master-plan-v1"},
    "code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "experiment_id": {"type": "string"},
    "run_id": {"type": "string"},
    "scope": {"enum": ["P", "S", "E"]},
    "task_id": {"type": "string"},
    "information_regime": {"enum": ["closed_set", "station_transfer", "zero_shot_source_only", "unlabeled_target_adaptation", "paired_calibration", "supervised_few_shot", "station_conditioned_open_set"]},
    "population_id": {"enum": ["primary_598", "notes_clear_500", "mira1_excluded_575", "notes_clear_mira1_excluded_479"]},
    "representation_id": {"type": "string"},
    "model_id": {"type": "string"},
    "hyperparameter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_epoch": {"type": ["integer", "null"], "minimum": 1},
    "station": {"enum": ["cwa", "pills", "surfaces"]},
    "held_instrument": {"type": ["string", "null"]},
    "held_sensor_family": {"type": ["string", "null"]},
    "held_chemical": {"type": ["string", "null"]},
    "outer_repeat": {"type": "integer", "minimum": 0},
    "outer_fold": {"type": "integer", "minimum": 0, "maximum": 3},
    "seed": {"type": ["integer", "null"]},
    "split_role": {"enum": ["train", "inner_validation", "calibration", "adaptation", "test", "excluded"]},
    "exclusion_reason": {"type": ["string", "null"]},
    "observation_uid": {"type": "string"},
    "source_scan_id": {"type": ["string", "number", "null"]},
    "master_sample_id": {"type": ["string", "number"]},
    "instrument": {"type": "string"},
    "instrument_serial": {"type": ["string", "null"]},
    "sensor_family": {"type": ["string", "null"]},
    "sensor_variant": {"type": ["string", "null"]},
    "target_analyte": {"type": "string"},
    "quality_tier": {"type": "string"},
    "true_label": {"type": "string"},
    "predicted_label": {"type": "string"},
    "class_vocabulary": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "probabilities": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2},
    "logits": {"type": ["array", "null"], "items": {"type": "number"}},
    "anomaly_scores": {"type": ["object", "null"], "additionalProperties": {"type": "number"}},
    "inference_time_ms": {"type": ["number", "null"], "minimum": 0},
    "run_status": {"enum": ["complete", "collapsed", "nan_failure", "resource_failure", "data_failure", "excluded_by_protocol"]},
    "failure_reason": {"type": ["string", "null"]}
  }
}
