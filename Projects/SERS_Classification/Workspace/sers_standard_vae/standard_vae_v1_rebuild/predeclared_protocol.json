  "status_before_model_execution": "predeclared",
  "scientific_question": "What does stochastic variational regularization add to the frozen deterministic SERS representation baselines before chemical/nuisance supervision or latent partitioning is introduced?",
  "terminal_scope": {
    "included": [
      "one-block unsupervised standard VAE",
      "inner-only KL-schedule selection",
      "frozen minimal_minmax sensitivity",
      "sealed NATO outer, field-stress, domain, corruption, and poster evaluation",
      "comparison to frozen PCA-logistic, Siamese, AE, and DAE baselines",
      "clean exact rebuild"
    ],
    "prohibited": [
      "beta-VAE beta search",
      "chemical classification loss in the encoder",
      "chemical/nuisance latent partition",
      "domain adversary",
      "domain-conditioned decoder",
      "triplet or contrastive VAE loss",
      "outer, stress, poster, or domain result use in model selection",
      "modification of preprocessing-v2 or baselines-v1"
    ]
  },
