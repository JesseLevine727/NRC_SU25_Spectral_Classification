  "frozen_model": {
    "primary_representation": "arpls_minmax",
    "mandatory_sensitivity_representation": "minimal_minmax",
    "channels": [
      8,
      16
    ],
    "kernels": [
      7,
      5
    ],
    "pool_after_each_convolution": 2,
    "latent_dimension": 64,
    "decoder": "symmetric deterministic nearest-upsampling-plus-convolution decoder with exact 1401-point output and sigmoid intensity",
    "reconstruction_loss": {
      "name": "spectral_composite",
      "smooth_l1_weight": 1.0,
      "spectral_angle_weight": 0.1,
      "first_derivative_weight": 0.1
    },
    "posterior": "diagonal Gaussian",
    "prior": "isotropic unit Gaussian",
    "evaluation_latent": "posterior_mean",
    "evaluation_reconstruction": "decoder_of_posterior_mean",
    "stochastic_training_samples_per_observation": 1,
    "beta": 1.0,
    "kl_definition": "mean over observations of the sum across 64 latent dimensions",
    "kl_normalization_divisor": 1401,
    "reason_for_kl_normalization": "The reconstruction components are means over the spectral axis. Dividing summed per-observation KL by the 1401 measured features expresses both ELBO terms per measured feature while retaining beta=1.",
    "training": {
      "optimizer": "Adam",
      "learning_rate": 0.001,
      "weight_decay": 0.00001,
      "batch_size": 64,
      "maximum_epochs": 100,
      "minimum_epochs": 30,
      "early_stopping_patience": 15,
      "early_stopping_minimum_delta": 0.00001,
      "gradient_clip_norm": 5.0,
      "validation_monitor": "full normalized negative ELBO at beta=1",
      "restore_best_epoch": true
    }
  },
  "vae_specific_search": {
    "selection_representation": "arpls_minmax",
    "selection_dataset": "NATO nested inner validation only",
    "fixed_beta": 1.0,
    "candidates": {
      "constant": {
        "schedule": "beta=1 from epoch 1"
      },
      "linear_warmup_20": {
        "schedule": "linear beta from 0 at epoch 1 to 1 at epoch 20, then beta=1"
      },
      "cyclical_4": {
        "schedule": "four equal 25-epoch cycles; beta rises linearly from 0 to 1 during the first half of each cycle and remains 1 during the second half"
      }
    },
    "strict_core_inner_folds_per_candidate": 20,
    "selection_seed": 1729,
    "quality_sensitivity": "Carry the two highest-utility gate-passing schedules to all 20 quality-pass inner folds. If none passes, carry the two highest-utility schedules but mark the final VAE diagnostic-only.",
