      "applicability": "representations with development-fitted class centroids and regularized covariance"
    },
    {
      "score": "negative_log_latent_density",
      "larger_means": "more_unknown",
      "applicability": "VAE or learned representations with development-fitted density"
    },
    {
      "score": "reconstruction_error",
      "larger_means": "more_unknown",
      "applicability": "autoencoding models"
    },
    {
      "score": "mc_dropout_mutual_information",
