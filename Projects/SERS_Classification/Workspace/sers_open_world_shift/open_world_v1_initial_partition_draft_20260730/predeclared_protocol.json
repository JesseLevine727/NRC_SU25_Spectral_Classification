      "train_known",
      "calibration_known",
      "excluded_outer_known_test",
      "locked_held_unknown",
      "locked_stress"
    ],
    "surrogate_inner_partitions": [
      "train_known",
      "validation_known",
      "validation_surrogate_unknown",
      "excluded_surrogate_training",
      "excluded_outer_known_test",
      "locked_held_unknown",
      "locked_stress"
    ]
  },
  "score_registry": [
    {
      "score": "one_minus_calibrated_max_probability",
